# Copia este archivo como .env en la VM y cambia los valores.
# NUNCA subas el .env a GitHub (ya está en .gitignore).

DB_USER=mercado
DB_PASSWORD=cambia-esta-contrasenia
DB_NAME=mercado-tiempo

# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto

# true crea/actualiza las tablas automáticamente (no hay migraciones aún)
DB_SYNCHRONIZE=true
